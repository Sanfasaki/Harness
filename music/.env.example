# 网易云音乐 MCP —— 本地凭据模板
#
# 复制成 .env 后填。.env 已被 .gitignore 排除，不会被提交。
#
# 怎么拿 cookie：
#   1. 浏览器打开 https://music.163.com 并登录
#   2. F12 -> Network -> 刷新页面
#   3. 点任意一个 music.163.com 的请求 -> Request Headers -> 复制 Cookie: 后面整串
#   4. 粘到下面 NETEASE_COOKIE= 后面（整串，不要加引号）
#
# 最少要含 MUSIC_U 和 __csrf。只放 MUSIC_U 容易在建歌单/改歌单时 403。
NETEASE_COOKIE=
NETEASE_CSRF=

# 服务端口与监听地址（两个服务都只给本机用，别改成 0.0.0.0 除非你知道后果）
MCP_PORT=3456
MCP_BIND=127.0.0.1
BRIDGE_PORT=3457
BRIDGE_BIND=127.0.0.1

# 工具输出里的时间戳时区，北京时间填 8
NETEASE_TZ_OFFSET=8

LOG_LEVEL=INFO
